# Local development settings for the control plane. These match deploy/docker-compose.yml and the imported
# Keycloak realm; none of them are fit for anything but a laptop.
DATABASE_URL=postgres://corazium:corazium-dev@127.0.0.1:55432/corazium
CLICKHOUSE_ADDR=127.0.0.1:59000
CLICKHOUSE_DB=corazium
CLICKHOUSE_USER=corazium
CLICKHOUSE_PASSWORD=corazium-dev
SEED_DEV=true

HTTP_ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:8080
WEB_URL=http://localhost:3210
GRPC_ADDR=127.0.0.1:8443
GRPC_PUBLIC_ADDR=localhost:8443
GRPC_SANS=localhost,127.0.0.1

OIDC_PROVIDER_ID=keycloak
OIDC_PROVIDER_NAME=Keycloak
OIDC_ISSUER=http://localhost:8081/realms/corazium
OIDC_CLIENT_ID=corazium-console
OIDC_CLIENT_SECRET=corazium-dev-secret
OIDC_ROLE_CLAIM=roles
# The dev realm does not emit an amr claim; its users all have TOTP, which Keycloak then always asks for.
OIDC_MFA_MODE=idp

# Optional:
# GEOIP_CITY_DB=/path/to/GeoLite2-City.mmdb
# GEOIP_ASN_DB=/path/to/GeoLite2-ASN.mmdb
# ESCALATION_WEBHOOK_URL=https://hooks.example.com/...
# BOOTSTRAP_ADMINS=someone@example.com
